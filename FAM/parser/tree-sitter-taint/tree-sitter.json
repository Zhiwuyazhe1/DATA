{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "taint",
      "camelcase": "Taint",
      "title": "Taint",
      "scope": "source.taint",
      "file-types": [
        "taint"
      ],
      "injection-regex": "^taint$",
      "class-name": "TreeSitterTaint"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "taint dsl parser",
    "authors": [
      {
        "name": "bruce",
        "email": "zhiwuyazhe154@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-taint"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}